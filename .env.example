# Driver used by Worm: sqlite, postgresql or mysql.
DATABASE_TYPE=sqlite

# Database name or SQLite file path. Use :memory: for an ephemeral SQLite database.
DBNAME=worm.db

# Required by PostgreSQL and MySQL. Ignored by SQLite.
HOST=localhost
PORT=5432
USERNAME=worm
PASSWORD=change-me

# Optional integration-test databases. PostgreSQL and MySQL contract tests are
# skipped locally when their respective DBNAME variable is absent.
WORM_TEST_POSTGRES_HOST=127.0.0.1
WORM_TEST_POSTGRES_PORT=5432
WORM_TEST_POSTGRES_DBNAME=worm_contract
WORM_TEST_POSTGRES_USERNAME=worm
WORM_TEST_POSTGRES_PASSWORD=worm

WORM_TEST_MYSQL_HOST=127.0.0.1
WORM_TEST_MYSQL_PORT=3306
WORM_TEST_MYSQL_DBNAME=worm_contract
WORM_TEST_MYSQL_USERNAME=worm
WORM_TEST_MYSQL_PASSWORD=worm
