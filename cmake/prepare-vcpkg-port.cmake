cmake_minimum_required(VERSION 3.20)

foreach(requiredVariable IN ITEMS WORM_SOURCE_ROOT WORM_OUTPUT_DIR)
  if(NOT DEFINED ${requiredVariable})
    message(FATAL_ERROR "${requiredVariable} is required.")
  endif()
  if("${${requiredVariable}}" STREQUAL "")
    message(FATAL_ERROR "${requiredVariable} is required.")
  endif()
endforeach()

cmake_path(ABSOLUTE_PATH WORM_SOURCE_ROOT NORMALIZE OUTPUT_VARIABLE sourceRoot)
cmake_path(ABSOLUTE_PATH WORM_OUTPUT_DIR NORMALIZE OUTPUT_VARIABLE outputDirectory)

include("${sourceRoot}/cmake/version.cmake")
worm_read_version("${sourceRoot}/vcpkg.json")

if(DEFINED WORM_LOCAL_SOURCE_PATH AND NOT WORM_LOCAL_SOURCE_PATH STREQUAL "")
  cmake_path(ABSOLUTE_PATH WORM_LOCAL_SOURCE_PATH NORMALIZE OUTPUT_VARIABLE localSourcePath)
  if(NOT EXISTS "${localSourcePath}/CMakeLists.txt")
    message(FATAL_ERROR "WORM_LOCAL_SOURCE_PATH must identify a Worm source tree.")
  endif()
  set(WORM_VCPKG_SOURCE_BLOCK "set(SOURCE_PATH [[${localSourcePath}]])")
elseif(DEFINED WORM_SOURCE_SHA512 AND NOT WORM_SOURCE_SHA512 STREQUAL "")
  string(LENGTH "${WORM_SOURCE_SHA512}" sourceHashLength)
  if(NOT sourceHashLength EQUAL 128 OR NOT WORM_SOURCE_SHA512 MATCHES "^[0-9A-Fa-f]+$")
    message(FATAL_ERROR "WORM_SOURCE_SHA512 must contain exactly 128 hexadecimal characters.")
  endif()
  string(TOLOWER "${WORM_SOURCE_SHA512}" sourceHash)
  set(WORM_VCPKG_SOURCE_BLOCK "vcpkg_from_github(\n    OUT_SOURCE_PATH SOURCE_PATH\n    REPO Dheovani/worm\n    REF \"v\${VERSION}\"\n    SHA512 ${sourceHash}\n)")
else()
  message(FATAL_ERROR "Set WORM_LOCAL_SOURCE_PATH for pre-tag validation or WORM_SOURCE_SHA512 for an immutable tag archive.")
endif()

file(MAKE_DIRECTORY "${outputDirectory}/worm")
configure_file("${sourceRoot}/cmake/vcpkg-port/portfile.cmake.in" "${outputDirectory}/worm/portfile.cmake" @ONLY)
configure_file("${sourceRoot}/cmake/vcpkg-port/vcpkg.json.in" "${outputDirectory}/worm/vcpkg.json" @ONLY)
configure_file("${sourceRoot}/cmake/vcpkg-port/usage" "${outputDirectory}/worm/usage" COPYONLY)

message(STATUS "Prepared Worm ${WORM_VERSION} vcpkg port in ${outputDirectory}/worm")
