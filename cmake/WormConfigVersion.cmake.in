# Numeric requests must not mistake a prerelease for its stable release.
set(PACKAGE_VERSION "@WORM_VERSION@")
if((NOT "@WORM_VERSION_PRERELEASE@" STREQUAL "" AND NOT "${PACKAGE_FIND_VERSION}" STREQUAL "")
    OR ("@WORM_VERSION_MAJOR@" STREQUAL "0" AND DEFINED PACKAGE_FIND_VERSION_RANGE)
    OR ("@WORM_VERSION_MAJOR@" STREQUAL "0" AND NOT "${PACKAGE_FIND_VERSION}" STREQUAL ""
      AND NOT PACKAGE_FIND_VERSION VERSION_EQUAL "@WORM_VERSION_NUMERIC@"))
  set(PACKAGE_VERSION_COMPATIBLE FALSE)
  set(PACKAGE_VERSION_EXACT FALSE)
  set(PACKAGE_VERSION_UNSUITABLE TRUE)
  return()
endif()

@WORM_NUMERIC_VERSION_CHECK@
