PROJECT_NAME           = "Worm"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "A typed C++20 ORM inspired by Doctrine"
OUTPUT_DIRECTORY       = "@WORM_DOXYGEN_OUTPUT_DIR@"
OUTPUT_LANGUAGE        = English

# Input and path presentation
INPUT                   = "@PROJECT_SOURCE_DIR@/src" \
                          "@PROJECT_SOURCE_DIR@/README.md" \
                          "@PROJECT_SOURCE_DIR@/TODO.md" \
                          "@PROJECT_SOURCE_DIR@/CONTRIBUTING.md" \
                          "@PROJECT_SOURCE_DIR@/CODE_OF_CONDUCT.md" \
                          "@PROJECT_SOURCE_DIR@/SECURITY.md" \
                          "@PROJECT_SOURCE_DIR@/.env.example" \
                          "@PROJECT_SOURCE_DIR@/cli/README.md" \
                          "@PROJECT_SOURCE_DIR@/examples/README.md" \
                          "@PROJECT_SOURCE_DIR@/docs"
FILE_PATTERNS           = *.hpp *.md *.example
RECURSIVE               = YES
EXCLUDE_PATTERNS        = */AGENTS.md
FULL_PATH_NAMES         = YES
STRIP_FROM_PATH         = "@PROJECT_SOURCE_DIR@/src" \
                          "@PROJECT_SOURCE_DIR@"
USE_MDFILE_AS_MAINPAGE  = "@PROJECT_SOURCE_DIR@/README.md"

# C++ and preprocessing
OPTIMIZE_OUTPUT_FOR_C   = NO
BUILTIN_STL_SUPPORT     = YES
ENABLE_PREPROCESSING    = YES
MACRO_EXPANSION         = YES
EXPAND_ONLY_PREDEF      = NO
SKIP_FUNCTION_MACROS    = YES

# API extraction
EXTRACT_ALL             = YES
EXTRACT_PRIVATE         = NO
EXTRACT_PACKAGE         = NO
EXTRACT_STATIC          = YES
EXTRACT_LOCAL_CLASSES   = NO
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO
INHERIT_DOCS            = YES

# Documentation rendering
MARKDOWN_SUPPORT        = YES
AUTOLINK_SUPPORT        = YES
JAVADOC_AUTOBRIEF       = YES
QT_AUTOBRIEF            = YES
MULTILINE_CPP_IS_BRIEF  = YES
SOURCE_BROWSER          = YES
INLINE_SOURCES          = NO
REFERENCED_BY_RELATION  = YES
REFERENCES_RELATION     = YES

# HTML is the only published format for now.
GENERATE_HTML           = YES
HTML_OUTPUT             = html
GENERATE_TREEVIEW       = YES
SEARCHENGINE            = YES
GENERATE_LATEX          = NO
GENERATE_XML            = NO
GENERATE_MAN            = NO

# Keep documentation useful while existing public headers are documented
# incrementally. Syntax and documentation errors are still reported.
QUIET                   = NO
WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = NO
WARN_IF_DOC_ERROR       = YES
WARN_IF_INCOMPLETE_DOC  = YES
WARN_NO_PARAMDOC        = YES
WARN_AS_ERROR           = NO
WARN_LOGFILE            = "@WORM_DOXYGEN_OUTPUT_DIR@/doxygen-warnings.log"

# Graphviz is optional. Doxygen still generates navigation without it.
HAVE_DOT                = @DOXYGEN_DOT_FOUND@
CLASS_GRAPH             = YES
COLLABORATION_GRAPH     = YES
INCLUDE_GRAPH           = YES
INCLUDED_BY_GRAPH       = YES
DOT_IMAGE_FORMAT        = svg
INTERACTIVE_SVG         = YES
