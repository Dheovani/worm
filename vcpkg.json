{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "worm",
  "version-semver": "0.1.0",
  "description": "A C++ ORM inspired by Doctrine",
  "builtin-baseline": "031f4afe03be385aee354f15be6e6b1fe57497c7",
  "dependencies": [],
  "default-features": [
    "mysql",
    "postgresql",
    "sqlite"
  ],
  "features": {
    "mysql": {
      "description": "Build the MySQL driver",
      "dependencies": [
        {
          "name": "libmysql",
          "platform": "windows"
        }
      ]
    },
    "postgresql": {
      "description": "Build the PostgreSQL driver",
      "dependencies": [
        "libpqxx"
      ]
    },
    "sqlite": {
      "description": "Build the SQLite driver",
      "dependencies": [
        "sqlite3"
      ]
    },
    "mssql": {
      "description": "Build the Microsoft SQL Server driver",
      "dependencies": [
        {
          "name": "unixodbc",
          "platform": "!windows"
        }
      ]
    }
  }
}
